{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NormalizedEvent",
  "type": "object",
  "required": [
    "event_id",
    "security_id",
    "event_family",
    "event_at",
    "evidence_ids",
    "rule_version"
  ],
  "properties": {
    "event_id": {
      "type": "string"
    },
    "security_id": {
      "type": "string"
    },
    "event_family": {
      "enum": [
        "EARNINGS_REVISION",
        "GUIDANCE_CHANGE",
        "CAPITAL_RETURN",
        "INSIDER_OPEN_MARKET_BUY",
        "ACTIVIST_OWNERSHIP",
        "MATERIAL_CORPORATE_EVENT",
        "FINANCING_DILUTION",
        "MNA_SPECIAL"
      ]
    },
    "event_at": {
      "type": "string",
      "format": "date-time"
    },
    "materiality_bucket": {
      "enum": [
        "LOW",
        "MEDIUM",
        "HIGH",
        "CRITICAL"
      ]
    },
    "evidence_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "facts": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "rule_version": {
      "type": "string"
    }
  }
}